# Copy to .env and fill in your Azure OpenAI key. Only the key is required;
# the rest have working defaults in rag/config.py.
AZURE_OPENAI_API_KEY=your-key-here

# Chat (gpt-4o-mini) and embeddings live on DIFFERENT gateways. The chat base
# defaults to sig-shared-jpeast in rag/config.py; override only if it moves.
# Do NOT point this at the embedding gateway (sig-embedding) - chat 404s there.
# AZURE_CHAT_ENDPOINT=https://api-iw.azure-api.net/sig-shared-jpeast
# CHAT_MODEL=gpt-4o-mini

# Embedding gateway (used by other parts of the project, not the chat pipeline):
# AZURE_OPENAI_ENDPOINT=https://api-iw.azure-api.net/sig-embedding
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Optional retrieval / latency overrides:
# SEMANTIC_TOP_K=8
# KEYWORD_TOP_K=5
# FINAL_TOP_N=6
# LLM_TIMEOUT=7
# ANSWER_TIMEOUT=9
